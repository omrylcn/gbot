# ═══════════════════════════════════════════════
# GraphBot Environment Variables
# Copy this file to .env and fill in your values
# ═══════════════════════════════════════════════

# ── LLM Providers (at least one required) ─────
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=
GROQ_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=

# ── Channels (optional) ──────────────────────
TELEGRAM_BOT_TOKEN=

# ── Overrides via GBOT_ prefix (optional) ─
# GBOT_ASSISTANT__MODEL=openai/gpt-4o
# GBOT_DATABASE__PATH=data/gbot.db
# GBOT_PROVIDERS__OPENAI__API_KEY=sk-...
