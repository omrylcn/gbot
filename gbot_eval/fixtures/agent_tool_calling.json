{
  "_comment": "Tool calling eval — 20 cases. Each case has a prompt, an available_tools subset (OpenAI function format), and expectations on which tool(s) get called with which args. Curated 2026-05-09.",
  "_tool_definitions": {
    "web_search": {
      "type": "function",
      "function": {
        "name": "web_search",
        "description": "Search the web for real-time information.",
        "parameters": {
          "type": "object",
          "properties": {
            "query": {"type": "string", "description": "The search query"},
            "count": {"type": "integer", "default": 5}
          },
          "required": ["query"]
        }
      }
    },
    "get_current_time": {
      "type": "function",
      "function": {
        "name": "get_current_time",
        "description": "Returns the current date and time in ISO format.",
        "parameters": {"type": "object", "properties": {}}
      }
    },
    "read_file": {
      "type": "function",
      "function": {
        "name": "read_file",
        "description": "Read a local file and return its content.",
        "parameters": {
          "type": "object",
          "properties": {"path": {"type": "string", "description": "Absolute file path"}},
          "required": ["path"]
        }
      }
    },
    "write_file": {
      "type": "function",
      "function": {
        "name": "write_file",
        "description": "Write text content to a local file (overwrites).",
        "parameters": {
          "type": "object",
          "properties": {
            "path": {"type": "string"},
            "content": {"type": "string"}
          },
          "required": ["path", "content"]
        }
      }
    },
    "save_user_note": {
      "type": "function",
      "function": {
        "name": "save_user_note",
        "description": "Persist a note to the user's long-term memory.",
        "parameters": {
          "type": "object",
          "properties": {"content": {"type": "string"}},
          "required": ["content"]
        }
      }
    },
    "list_dir": {
      "type": "function",
      "function": {
        "name": "list_dir",
        "description": "List the contents of a directory.",
        "parameters": {
          "type": "object",
          "properties": {"path": {"type": "string"}},
          "required": ["path"]
        }
      }
    }
  },
  "cases": [
    {
      "case_id": "tc01",
      "_intent": "single tool — web search",
      "task": "İstanbul'un bugünkü hava durumunu öğrenmek istiyorum.",
      "tools": ["web_search"],
      "expected_tool_names": ["web_search"],
      "required_args": {"web_search": ["query"]}
    },
    {
      "case_id": "tc02",
      "_intent": "single tool — current time",
      "task": "Şu an saat kaç?",
      "tools": ["get_current_time", "web_search"],
      "expected_tool_names": ["get_current_time"],
      "forbidden_tool_names": ["web_search"]
    },
    {
      "case_id": "tc03",
      "_intent": "single tool — read file",
      "task": "/etc/hostname dosyasını oku.",
      "tools": ["read_file", "list_dir"],
      "expected_tool_names": ["read_file"],
      "required_args": {"read_file": ["path"]},
      "expected_arg_substring": {"read_file": {"path": "hostname"}}
    },
    {
      "case_id": "tc04",
      "_intent": "single tool — list directory",
      "task": "/tmp klasöründe ne var, listele.",
      "tools": ["read_file", "list_dir"],
      "expected_tool_names": ["list_dir"],
      "required_args": {"list_dir": ["path"]}
    },
    {
      "case_id": "tc05",
      "_intent": "single tool — save note",
      "task": "Şunu hatırla: yarın 15:00'te diş hekimi randevum var.",
      "tools": ["save_user_note", "web_search"],
      "expected_tool_names": ["save_user_note"],
      "required_args": {"save_user_note": ["content"]},
      "expected_arg_substring": {"save_user_note": {"content": "diş"}}
    },
    {
      "case_id": "tc06",
      "_intent": "single tool — write file",
      "task": "/tmp/test.txt dosyasına 'Merhaba dünya' yaz.",
      "tools": ["write_file", "read_file"],
      "expected_tool_names": ["write_file"],
      "required_args": {"write_file": ["path", "content"]}
    },
    {
      "case_id": "tc07",
      "_intent": "single tool — Türkçe ürün araştırma",
      "task": "OnePlus Pad 3 hakkında bilgi al.",
      "tools": ["web_search"],
      "expected_tool_names": ["web_search"],
      "required_args": {"web_search": ["query"]}
    },
    {
      "case_id": "tc08",
      "_intent": "single tool — bilgi sorgu",
      "task": "Bitcoin fiyatı ne kadar şu anda?",
      "tools": ["web_search", "get_current_time"],
      "expected_tool_names": ["web_search"]
    },
    {
      "case_id": "tc09",
      "_intent": "multi-tool — read + save",
      "task": "/tmp/notes.txt dosyasını oku ve içeriğini hafızama kaydet.",
      "tools": ["read_file", "save_user_note", "write_file"],
      "expected_any_of": [["read_file", "save_user_note"], ["read_file"]],
      "expected_at_least_n_tools": 1
    },
    {
      "case_id": "tc10",
      "_intent": "multi-tool — list + read",
      "task": "/etc klasörünü listele, sonra /etc/os-release dosyasını oku.",
      "tools": ["list_dir", "read_file"],
      "expected_any_of": [["list_dir", "read_file"], ["list_dir"]],
      "expected_at_least_n_tools": 1
    },
    {
      "case_id": "tc11",
      "_intent": "multi-tool — search + save",
      "task": "Yapay zeka haberlerini araştır ve önemli olanı not et.",
      "tools": ["web_search", "save_user_note"],
      "expected_any_of": [["web_search", "save_user_note"], ["web_search"]],
      "expected_at_least_n_tools": 1
    },
    {
      "case_id": "tc12",
      "_intent": "multi-tool — read + write",
      "task": "/tmp/in.txt'i oku, içeriğini büyük harfe çevirip /tmp/out.txt'e yaz.",
      "tools": ["read_file", "write_file"],
      "expected_any_of": [["read_file", "write_file"], ["read_file"]],
      "expected_at_least_n_tools": 1
    },
    {
      "case_id": "tc13",
      "_intent": "multi-tool — time + save",
      "task": "Şu anki tarihi notuma ekle.",
      "tools": ["get_current_time", "save_user_note"],
      "expected_any_of": [["get_current_time", "save_user_note"], ["save_user_note"]],
      "expected_at_least_n_tools": 1
    },
    {
      "case_id": "tc14",
      "_intent": "no tool — sohbet",
      "task": "Merhaba, bugün nasılsın?",
      "tools": ["web_search", "get_current_time"],
      "expected_no_tool_call": true
    },
    {
      "case_id": "tc15",
      "_intent": "no tool — bilgi cevabı yetenek dahili",
      "task": "Python'da liste nasıl tersine çevrilir, kısa açıkla.",
      "tools": ["web_search"],
      "expected_no_tool_call": true
    },
    {
      "case_id": "tc16",
      "_intent": "no tool — felsefi soru",
      "task": "Mutluluk nedir sence?",
      "tools": ["web_search", "save_user_note"],
      "expected_no_tool_call": true
    },
    {
      "case_id": "tc17",
      "_intent": "no tool — küçük talk",
      "task": "Teşekkür ederim, çok yardımcı oldun.",
      "tools": ["save_user_note"],
      "expected_no_tool_call": true
    },
    {
      "case_id": "tc18",
      "_intent": "ambiguous — file path missing",
      "task": "Şu dosyayı düzenler misin?",
      "tools": ["read_file", "write_file"],
      "expected_no_tool_call": true,
      "_note": "Path missing — model should ask for clarification, not hallucinate path"
    },
    {
      "case_id": "tc19",
      "_intent": "ambiguous — search query unclear",
      "task": "Bir şeyler ara.",
      "tools": ["web_search"],
      "expected_no_tool_call": true,
      "_note": "Query missing — model should ask, not call with empty query"
    },
    {
      "case_id": "tc20",
      "_intent": "wrong tool offered — model shouldn't pick it",
      "task": "Hava durumu ne? (sadece save_user_note tool'u var)",
      "tools": ["save_user_note"],
      "expected_no_tool_call": true,
      "_note": "Available tool can't satisfy the request — should not misuse save_user_note"
    }
  ]
}
